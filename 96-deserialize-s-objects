public List<Account> getAccountsFromJSONString(String inputJSON){
    if(inputJSON == null || String.isNotBlank(inputJSON))  return null;
    list<account> a = new list<Account>();
    List<sObject> nn = JSON.deserialize(inputJSON);
    for(sobject n : nn) {
        a.add((Account) n);
    }
    return a;
}